# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# SQLite database files (use seed_demo_data.py to generate fresh)
*.db
*.sqlite
*.sqlite3

# Uploaded user media (keep the directory tracked via .gitkeep)
app/static/avatars/*
!app/static/avatars/.gitkeep

# Environment variables & local secrets
.env
.env.local
.env.*.local

# IDE & Editor files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Logs & scratch test files
*.log
scratch/
